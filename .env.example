# Программа читает эти переменные из окружения; сам файл .env она не загружает.
#   Bash:       set -a; source .env; set +a
#   PowerShell: $env:YANDEX_API_KEY = "..."
# Реальные значения в репозиторий не коммитим.

# Провайдер: yandex (по умолчанию) или gigachat
LLM_PROVIDER=yandex

# --- YandexGPT ---
# API-ключ сервисного аккаунта (роль ai.languageModels.user)
YANDEX_API_KEY=
# ID каталога в Yandex Cloud, вида b1g...
YANDEX_FOLDER_ID=
# Необязательно: yandexgpt-lite/latest (по умолчанию) или yandexgpt/latest
YANDEX_MODEL=
# Необязательно: адрес OpenAI-совместимого API, по умолчанию https://ai.api.cloud.yandex.net/v1
YANDEX_BASE_URL=

# --- GigaChat ---
# Ключ авторизации из личного кабинета (Base64 от client_id:secret)
GIGACHAT_AUTH_KEY=
# Путь к корневому сертификату НУЦ Минцифры (PEM или DER)
GIGACHAT_CA_FILE=
# Необязательно: GIGACHAT_API_PERS (по умолчанию) для физлиц
GIGACHAT_SCOPE=
# Необязательно: GigaChat-2 (по умолчанию)
GIGACHAT_MODEL=
# Только для локальной отладки: 1 отключает проверку TLS-сертификата (в лог пишется предупреждение)
# GIGACHAT_INSECURE=1
